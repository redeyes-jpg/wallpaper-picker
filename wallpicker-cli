#!/bin/bash
# wallpicker-cli — config, wallpaper cycling, keybind management, .desktop install.
set -uo pipefail

CONFIG_FILE="${WALLPICKER_CONFIG:-$HOME/.config/omarchy/wallpicker.json}"
STATE_DIR="${WALLPICKER_STATE_DIR:-$HOME/.local/state/omarchy/wallpicker}"
THUMB_DIR="${WALLPICKER_THUMB_DIR:-$HOME/.cache/wallpicker/thumbs}"
COLLECTIONS_DIR="${WALLPICKER_COLLECTIONS_DIR:-$HOME/.local/share/wallpicker/collections}"
THUMB_WIDTH=300
OMARCHY_THEMES_DIR="${OMARCHY_THEMES_DIR:-$HOME/.local/share/omarchy/themes}"
STATE_FILE="$STATE_DIR/rotation.json"
LUA_FILE="$HOME/.config/hypr/wallpicker.lua"
HL_FILE="$HOME/.config/hypr/hyprland.lua"
HL_MARKER="require(\"hypr.wallpicker\") -- wallpicker-managed"

CONFIG_VERSION=1

DEFAULT_CONFIG='{
  "version": 1,
  "picturesDir": "~/Pictures",
  "recursive": false,
  "columns": 5,
  "rotationEnabled": false,
  "rotationIntervalMin": 30,
  "rotationRandom": true,
  "keybindOpen": "",
  "keybindToggleRotation": "",
  "keybindRotateNow": ""
}'

die() { echo "wallpicker: $*" >&2; exit 1; }

# ---------------------------------------------------------------- config

ensure_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    local version
    version=$(jq -r '.version // 0' "$CONFIG_FILE" 2>/dev/null || echo 0)
    if [[ "$version" != "$CONFIG_VERSION" ]]; then
      cp -f "$CONFIG_FILE" "$CONFIG_FILE.bak" 2>/dev/null
      printf '%s\n' "$DEFAULT_CONFIG" > "$CONFIG_FILE"
    fi
  else
    mkdir -p "$(dirname "$CONFIG_FILE")"
    printf '%s\n' "$DEFAULT_CONFIG" > "$CONFIG_FILE"
  fi
}

cfg() {
  ensure_config
  jq -r --arg k "$1" --argjson d "$DEFAULT_CONFIG" \
    'if (.[$k] == null) then $d[$k] else .[$k] end' "$CONFIG_FILE"
}

NUMERIC_KEYS=" columns rotationIntervalMin version "
BOOL_KEYS=" recursive rotationEnabled rotationRandom "

cfg_set() {
  ensure_config
  local key=$1 value=$2 tmp
  if [[ $NUMERIC_KEYS == *" $key "* ]]; then
    [[ $value =~ ^-?[0-9]+$ ]] || die "$key must be a whole number, got: $value"
    tmp=$(jq --arg k "$key" --argjson v "$value" '.[$k] = $v' "$CONFIG_FILE")
  elif [[ $BOOL_KEYS == *" $key "* ]]; then
    case "$value" in
      true)  v=true ;;
      false) v=false ;;
      *) die "$key must be true or false, got: $value" ;;
    esac
    tmp=$(jq --arg k "$key" --argjson v "$v" '.[$k] = $v' "$CONFIG_FILE")
  else
    tmp=$(jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$CONFIG_FILE")
  fi
  [[ -n $tmp ]] || die "failed to update $key"
  printf '%s\n' "$tmp" > "$CONFIG_FILE"
}

# ---------------------------------------------------------------- thumbs

thumb_hash() {
  printf '%s' "$1" | md5sum | cut -c1-32
}

thumb_path() {
  echo "$THUMB_DIR/$(thumb_hash "$1").jpg"
}

# Echo a JSON object {path, thumb} for $1.
# `thumb` is emitted only when the cached file already exists, so the UI can
# fall back to the original image instead of blocking on thumbnail creation.
emit_path_thumb() {
  local src="$1"
  local dst
  dst=$(thumb_path "$src")
  if [[ -f "$dst" ]]; then
    jq -cn --arg path "$src" --arg thumb "$dst" '{path: $path, thumb: $thumb}'
  else
    jq -cn --arg path "$src" '{path: $path, thumb: ""}'
  fi
}

# Read newline-separated paths on stdin, emit a JSON array of {path, thumb}.
emit_paths_json() {
  local tmp
  tmp=$(mktemp)
  local src
  while IFS= read -r src; do
    [[ -n "$src" && -f "$src" ]] || continue
    emit_path_thumb "$src" >> "$tmp"
  done
  jq -s '.' "$tmp"
  rm -f "$tmp"
}

cmd_list() {
  local pictures_dir depth tmp
  pictures_dir=$(cfg picturesDir)
  [[ -n "$pictures_dir" ]] || die "picturesDir is empty"
  pictures_dir="${pictures_dir/#\~/$HOME}"

  [[ -d "$pictures_dir" ]] || die "directory not found: $pictures_dir"

  depth=1
  [[ "$(cfg recursive)" == "true" ]] && depth=99

  tmp=$(mktemp)
  while IFS= read -r src; do
    [[ -n "$src" ]] || continue
    emit_path_thumb "$src" >> "$tmp"
  done < <(find "$pictures_dir" -maxdepth "$depth" -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o \
       -iname '*.webp' -o -iname '*.bmp' -o -iname '*.gif' -o -iname '*.tiff' \) \
    2>/dev/null | sort)

  jq -s '.' "$tmp"
  rm -f "$tmp"
}

cmd_thumbs() {
  mkdir -p "$THUMB_DIR"
  command -v vipsthumbnail >/dev/null 2>&1 || { jq -n '{generated: 0, skipped: 0, unsupported: true}'; return 0; }

  local pictures_dir depth jobs jobs_max
  pictures_dir=$(cfg picturesDir)
  [[ -n "$pictures_dir" ]] || die "picturesDir is empty"
  pictures_dir="${pictures_dir/#\~/$HOME}"

  depth=1
  [[ "$(cfg recursive)" == "true" ]] && depth=99

  jobs_max=$(nproc 2>/dev/null || echo 2)
  jobs=$(( jobs_max > 8 ? 8 : jobs_max ))
  [[ "$jobs" -lt 1 ]] && jobs=1

  local queue count generated skipped
  queue=$(mktemp)

  # Queue every image that has no fresh cached thumbnail.
  {
    if [[ -d "$pictures_dir" ]]; then
      find "$pictures_dir" -maxdepth "$depth" -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o \
           -iname '*.webp' -o -iname '*.bmp' -o -iname '*.gif' -o -iname '*.tiff' \) \
        2>/dev/null
    fi
    if [[ -d "$OMARCHY_THEMES_DIR" ]]; then
      find "$OMARCHY_THEMES_DIR" -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        2>/dev/null
    fi
    # Wallpapers filed in collections may live outside picturesDir.
    if [[ -d "$COLLECTIONS_DIR" ]]; then
      find "$COLLECTIONS_DIR" -maxdepth 1 -type f -name '*.json' -exec jq -r '.paths[]? // empty' {} + 2>/dev/null
    fi
  } | while IFS= read -r src; do
      local dst
      dst=$(thumb_path "$src")
      if [[ -f "$dst" && "$dst" -nt "$src" ]]; then
        continue
      fi
      printf '%s\0%s\0' "$src" "$dst"
    done > "$queue"

  count=$(tr -cd '\0' < "$queue" | wc -c)
  count=$((count / 2))
  skipped=$count

  if [[ "$count" -gt 0 ]]; then
    export THUMB_WIDTH
    xargs -0 -n 2 -P "$jobs" sh -c \
      'vipsthumbnail "$1" -s "$THUMB_WIDTH" -o "$2[Q=80]" >/dev/null 2>&1 || true' _ \
      < "$queue" >/dev/null 2>&1 || true
  fi

  rm -f "$queue"

  generated=0
  if [[ -d "$THUMB_DIR" ]]; then
    generated=$(find "$THUMB_DIR" -maxdepth 1 -type f -name '*.jpg' 2>/dev/null | wc -l)
  fi
  jq -n --argjson cached "$generated" --argjson queued "$skipped" \
    '{cached: $cached, queued: $queued}'
}

# ---------------------------------------------------------------- collections

collections_dir() {
  mkdir -p "$COLLECTIONS_DIR"
  echo "$COLLECTIONS_DIR"
}

omarchy_themes_dir() {
  mkdir -p "$OMARCHY_THEMES_DIR"
  echo "$OMARCHY_THEMES_DIR"
}

# Path of the JSON file backing a user collection named $1 (empty if absent).
collection_file_for() {
  local name="$1"
  local dir
  dir=$(collections_dir)
  local f
  for f in "$dir"/*.json; do
    [[ -f "$f" ]] || continue
    local fname
    fname=$(jq -r '.name // ""' "$f" 2>/dev/null) || fname=""
    if [[ "$fname" == "$name" ]]; then
      echo "$f"
      return 0
    fi
  done
  return 1
}

cmd_collections_list() {
  local dir tmp
  dir=$(collections_dir)
  tmp=$(mktemp)

  local f
  for f in "$dir"/*.json; do
    [[ -f "$f" ]] || continue
    local name id enriched
    name=$(jq -r '.name // "Untitled"' "$f" 2>/dev/null)
    id=$(jq -r '.id // ""' "$f" 2>/dev/null)
    enriched=$(jq -r '.paths[]?' "$f" 2>/dev/null | emit_paths_json)
    jq -cn --arg name "$name" --arg id "$id" --argjson paths "${enriched:-[]}" \
      '{name: $name, id: $id, paths: $paths}' >> "$tmp"
  done

  # Default collection: omarchy themes
  local themes_dir enriched_themes
  themes_dir=$(omarchy_themes_dir)
  enriched_themes=$(find "$themes_dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort | emit_paths_json)
  jq -cn --argjson paths "${enriched_themes:-[]}" \
    '{name: "Omarchy Themes", id: "omarchy", paths: $paths}' >> "$tmp"

  jq -s '.' "$tmp"
  rm -f "$tmp"
}

cmd_collections_create() {
  local name="${1:?usage: wallpicker collections create <name>}"
  # Trim surrounding whitespace.
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"
  [[ -n "$name" ]] || die "collection name is empty"
  [[ "$name" == "Omarchy Themes" ]] && die "\"Omarchy Themes\" is a built-in collection"

  local dir
  dir=$(collections_dir)

  # Refuse duplicates (names are the user-facing identifier).
  if [[ -n "$(collection_file_for "$name")" ]]; then
    jq -n --arg name "$name" '{error: "Collection already exists: \($name)"}'
    return 1
  fi

  # Slug for id; keep it unique even when two collections map to the same slug.
  local id slug
  slug=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-_' | tr -s '-')
  slug="${slug:-collection}"
  id="${slug}_$(date +%s)"
  local file="$dir/${id}.json"
  local suffix=1
  while [[ -f "$file" ]]; do
    file="$dir/${id}-${suffix}.json"
    suffix=$((suffix + 1))
  done

  jq -n --arg name "$name" --arg id "$id" \
    '{name: $name, id: $id, paths: []}' > "$file"
  jq -n --arg name "$name" --arg id "$id" '{name: $name, id: $id, created: true}'
}

cmd_collections_add() {
  local name="${1:?usage: wallpicker collections add <name> <path>...}"
  shift

  [[ "$name" == "Omarchy Themes" ]] \
    && die "the \"Omarchy Themes\" collection is managed by Omarchy and cannot be edited"

  local file
  file=$(collection_file_for "$name")
  if [[ -z "$file" ]]; then
    jq -n --arg name "$name" '{error: "Collection not found: \($name)"}' >&2
    return 1
  fi

  # Only existing image files can be added.
  local -a wanted=()
  local p lower
  for p in "$@"; do
    [[ -n "$p" ]] || continue
    [[ -f "$p" ]] || continue
    lower=$(echo "$p" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
      *.png|*.jpg|*.jpeg|*.webp|*.bmp|*.gif|*.tiff|*.PNG|*.JPG|*.JPEG|*.WEBP|*.BMP|*.GIF|*.TIFF)
        wanted+=("$p") ;;
    esac
  done

  local before after
  before=$(jq '[.paths[]?] | length' "$file" 2>/dev/null || echo 0)
  before=${before:-0}

    if [[ ${#wanted[@]} -gt 0 ]]; then
    local paths_json
    paths_json=$(printf '%s\n' "${wanted[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')
    jq --argjson add "$paths_json" \
       '.paths = (((.paths // []) + $add)
                    | reduce .[] as $p ([]; if index($p) == null then . + [$p] else . end))' \
       "$file" > "$file.tmp" 2>/dev/null \
      && mv "$file.tmp" "$file"
  fi

  after=$(jq '[.paths[]?] | length' "$file" 2>/dev/null || echo 0)
  after=${after:-0}

  jq -n --argjson added "$((after - before))" --argjson skipped "$(( ${#wanted[@]} - (after - before) ))" \
    '{added: $added, alreadyIn: $skipped}'
}

cmd_collections_remove() {
  local name="${1:?usage: wallpicker collections remove <name> <path>...}"
  shift

  [[ "$name" == "Omarchy Themes" ]] \
    && die "the \"Omarchy Themes\" collection is managed by Omarchy and cannot be edited"

  local file
  file=$(collection_file_for "$name")
  [[ -z "$file" ]] && { jq -n '{removed: 0}'; return 0; }

  local before after
  before=$(jq '[.paths[]?] | length' "$file" 2>/dev/null || echo 0)
  before=${before:-0}

  local remove_json
  remove_json=$(printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length > 0))')
  jq --argjson remove "$remove_json" \
    '.paths = [.paths[]? | select(. as $p | ($remove | index($p)) | not)]' "$file" > "$file.tmp" \
    && mv "$file.tmp" "$file"

  after=$(jq '[.paths[]?] | length' "$file" 2>/dev/null || echo 0)
  after=${after:-0}

  jq -n --argjson n "$((before - after))" '{removed: $n}'
}

cmd_collections_delete() {
  local name="${1:?usage: wallpicker collections delete <name>}"

  [[ "$name" == "Omarchy Themes" ]] \
    && die "the \"Omarchy Themes\" collection is built in and cannot be deleted"

  local file
  file=$(collection_file_for "$name")

  if [[ -n "$file" && -f "$file" ]]; then
    rm -f "$file"
    jq -n '{deleted: true}'
  else
    jq -n '{deleted: false}'
  fi
}

cmd_collections_prune() {
  [[ $# -gt 0 ]] || die "usage: wallpicker collections prune <path>..."
  local dir
  dir=$(collections_dir)
  local removed=0
  local f
  for f in "$dir"/*.json; do
    [[ -f "$f" ]] || continue
    local before after
    before=$(jq '[.paths[]?] | length' "$f" 2>/dev/null || echo 0)
    jq --argjson rm "$(printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
      '.paths = [.paths[]? | select(. as $p | ($rm | index($p)) | not)]' "$f" > "$f.tmp" 2>/dev/null \
      && mv "$f.tmp" "$f"
    after=$(jq '[.paths[]?] | length' "$f" 2>/dev/null || echo 0)
    removed=$((removed + before - after))
  done
  jq -n --argjson n "$removed" '{removed: $n}'
}

# ---------------------------------------------------------------- themes

cmd_themes_list() {
  local themes_dir
  themes_dir=$(omarchy_themes_dir)
  find "$themes_dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort | emit_paths_json
}

# ---------------------------------------------------------------- remove

cmd_remove() {
  local pictures_dir real_dir path real removed_json failed_json
  pictures_dir=$(cfg picturesDir)
  [[ -n "$pictures_dir" ]] || die "picturesDir is empty"
  pictures_dir="${pictures_dir/#\~/$HOME}"
  [[ -d "$pictures_dir" ]] || die "directory not found: $pictures_dir"
  real_dir=$(realpath -e -- "$pictures_dir") || die "cannot resolve picturesDir: $pictures_dir"
  [[ $# -gt 0 ]] || die "usage: wallpicker remove <path>..."

  local -a removed=() failed=()
  for path in "$@"; do
    if [[ ! -f "$path" ]]; then
      failed+=("$path")
      continue
    fi
    real=$(realpath -e -- "$path" 2>/dev/null) || {
      failed+=("$path")
      continue
    }
    # Only allow files inside the configured pictures directory.
    if [[ "$real_dir" != "/" && "$real" != "$real_dir"/* ]]; then
      failed+=("$path")
      continue
    fi
    case "${real,,}" in
      *.png|*.jpg|*.jpeg|*.webp|*.bmp|*.gif|*.tiff) ;;
      *)
        failed+=("$path")
        continue
        ;;
    esac
    if gio trash -- "$real" >/dev/null 2>&1; then
      removed+=("$real")
    else
      failed+=("$path")
    fi
  done

  removed_json=$(printf '%s\n' "${removed[@]:-}" | jq -Rsc 'split("\n") | map(select(length > 0))')
  failed_json=$(printf '%s\n' "${failed[@]:-}" | jq -Rsc 'split("\n") | map(select(length > 0))')

  # Clean up cached thumbnails + collection memberships for removed wallpapers
  for real in "${removed[@]:-}"; do
    [[ -n "$real" ]] || continue
    rm -f "$(thumb_path "$real")" 2>/dev/null
  done
  if [[ ${#removed[@]} -gt 0 ]]; then
    cmd_collections_prune "${removed[@]}" >/dev/null 2>&1 || true
  fi

  jq -n --argjson removed "$removed_json" --argjson failed "$failed_json" \
    '{removed: $removed, failed: $failed}'
}

# ---------------------------------------------------------------- apply

cmd_apply() {
  local path=$1
  [[ -n "$path" ]] || die "no wallpaper path given"
  [[ -f "$path" ]] || die "file not found: $path"
  omarchy theme bg set "$path" >/dev/null 2>&1 \
    || omarchy-theme-bg-set "$path" >/dev/null 2>&1 \
    || die "failed to set background"
  stamp "$path"
}

# ---------------------------------------------------------------- state

ensure_state() { mkdir -p "$STATE_DIR"; }

stamp() {
  ensure_state
  local now_ms
  now_ms=$(date +%s%3N 2>/dev/null || python3 -c "import time;print(int(time.time()*1000))")
  if [[ -f "$STATE_FILE" ]]; then
    # Merge — preserve rotationIndex written by cmd_next.
    jq --argjson ms "$now_ms" --arg path "${1:-}" \
      '.lastRotatedMs = $ms | .lastAppliedPath = $path' \
      "$STATE_FILE" > "$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"
  else
    jq -n --argjson ms "$now_ms" --arg path "${1:-}" \
      '{"lastRotatedMs": $ms, "rotationIndex": 0, "lastAppliedPath": $path}' > "$STATE_FILE"
  fi
}

# ---------------------------------------------------------------- next

cmd_next() {
  local count list_json last_path random index path
  list_json=$(cmd_list)
  count=$(jq length <<< "$list_json")
  [[ "$count" -gt 0 ]] || die "no wallpapers found"

  last_path=""
  [[ -f "$STATE_FILE" ]] && last_path=$(jq -r '.lastAppliedPath // ""' "$STATE_FILE")

  # Index of the last applied wallpaper, or -1 when it is not in the list.
  local last_idx
  last_idx=$(jq --arg p "$last_path" \
    'map(.path) | to_entries | map(select(.value == $p)) | if length > 0 then .[0].key else -1 end' <<< "$list_json")
  [[ "$last_idx" =~ ^[0-9]+$ ]] || last_idx=-1

  random=$(cfg rotationRandom)
  if [[ "$random" == "true" ]]; then
    # Random, but never the same wallpaper twice in a row.
    if [[ "$count" -gt 1 ]]; then
      local candidates idxs=() i
      candidates=$(jq -r 'to_entries | map(select(.key != '"$last_idx"')) | .[].key' <<< "$list_json")
      while IFS= read -r i; do idxs+=("$i"); done <<< "$candidates"
      index=${idxs[$(( RANDOM % ${#idxs[@]} ))]}
    else
      index=0
    fi
  else
    # Sequential: next after the last applied, wrapping.
    if [[ "$last_idx" -ge 0 && "$count" -gt 1 ]]; then
      index=$(( (last_idx + 1) % count ))
    else
      index=$(jq -r '.rotationIndex // 0' "$STATE_FILE" 2>/dev/null || echo 0)
      index=$(( index % count ))
      # If that lands on the same image we just applied, advance once.
      [[ "$index" -eq "$last_idx" && "$count" -gt 1 ]] && index=$(( (index + 1) % count ))
    fi
  fi

  ensure_state
  path=$(jq -r ".[$index].path" <<< "$list_json")
  jq --argjson idx "$index" --arg p "$path" \
    '.rotationIndex = $idx | .lastAppliedPath = $p' "$STATE_FILE" \
    > "$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"

  cmd_apply "$path"
  echo "$path"
}

# ---------------------------------------------------------------- keybinds

# Top-level statements, same as the user's bindings.lua: Hyprland clears
# module caches on every reload, so re-requiring re-applies the binds.
emit_lua() {
  local bind="$1" unbind="$2"
  { echo "-- wallpicker-managed (auto-generated, do not edit)"
    [[ -n "$unbind" ]] && echo -e "$unbind"
    [[ -n "$bind" ]] && echo -e "$bind"
  } > "$LUA_FILE"
  chmod 644 "$LUA_FILE"
}

apply_keybinds() {
  ensure_config
  local open_bind toggle_bind rotate_bind
  open_bind=$(cfg keybindOpen)
  toggle_bind=$(cfg keybindToggleRotation)
  rotate_bind=$(cfg keybindRotateNow)

  if [[ -z "$open_bind" && -z "$toggle_bind" && -z "$rotate_bind" ]]; then
    clear_keybinds
    return
  fi

  local bind="" unbind=""
  if [[ -n "$open_bind" ]]; then
    unbind+="hl.unbind(\"$open_bind\")\n"
    bind+="o.bind(\"$open_bind\", \"Wallpaper picker\", \"omarchy-shell wallpicker open\")\n"
  fi
  if [[ -n "$toggle_bind" ]]; then
    unbind+="hl.unbind(\"$toggle_bind\")\n"
    bind+="o.bind(\"$toggle_bind\", \"Toggle wallpaper rotation\", \"omarchy-shell wallpicker toggleRotation\")\n"
  fi
  if [[ -n "$rotate_bind" ]]; then
    unbind+="hl.unbind(\"$rotate_bind\")\n"
    bind+="o.bind(\"$rotate_bind\", \"Rotate wallpaper now\", \"omarchy-shell wallpicker cycleNow\")\n"
  fi

  emit_lua "$bind" "$unbind"

  # Ensure the require line sits right after bindings.lua is loaded.
  if ! grep -qF "$HL_MARKER" "$HL_FILE" 2>/dev/null; then
    sed -i "0,/^require(\"hypr.bindings\")$/s//require(\"hypr.bindings\")\n$HL_MARKER/" "$HL_FILE"
  fi

  hyprctl reload >/dev/null 2>&1 || true
}

clear_keybinds() {
  rm -f "$LUA_FILE"
  if [[ -f "$HL_FILE" ]] && grep -qF "$HL_MARKER" "$HL_FILE"; then
    sed -i "/^$HL_MARKER$/d" "$HL_FILE"
  fi
  hyprctl reload >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------- desktop

DESKTOP_MARKER="X-Wallpicker-Managed=true"

desktop_install() {
  local source_dir=${1:-.}
  local dest="$HOME/.local/share/applications/wallpicker.desktop"
  local template="$source_dir/wallpicker.desktop"

  [[ -f "$template" ]] || die "template not found: $template"
  # Never clobber a user-owned file.
  if [[ -e "$dest" ]] && ! grep -q "$DESKTOP_MARKER" "$dest" 2>/dev/null; then
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  local tmp="$dest.wallpicker.new"
  sed "s|@ICON@|preferences-desktop-wallpaper|" "$template" > "$tmp" || return 0
  if cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"
  else
    mv -f "$tmp" "$dest"
  fi
}

desktop_remove() {
  local dest="$HOME/.local/share/applications/wallpicker.desktop"
  [[ -e "$dest" ]] && grep -q "$DESKTOP_MARKER" "$dest" 2>/dev/null && rm -f "$dest"
}

# ---------------------------------------------------------------- wallhaven config

wallhaven_config_get() {
  ensure_config
  local key=$1 base
  base=$(jq -c '.wallhaven // {}' "$CONFIG_FILE")
  case "$key" in
    categories) jq -nr --arg k "$key" --argjson b "$base" --arg d "111" '$b[$k] // $d' ;;
    purity)     jq -nr --arg k "$key" --argjson b "$base" --arg d "100" '$b[$k] // $d' ;;
    sorting)    jq -nr --arg k "$key" --argjson b "$base" --arg d "date_added" '$b[$k] // $d' ;;
    ratios)     jq -nr --arg k "$key" --argjson b "$base" --arg d "16x9" '$b[$k] // $d' ;;
    atleast)    jq -nr --arg k "$key" --argjson b "$base" --arg d "" '$b[$k] // $d' ;;
    *)          jq -nr --arg k "$key" --argjson b "$base" '$b[$k] // empty' ;;
  esac
}

wallhaven_config_set() {
  ensure_config
  local key=$1 value=$2 tmp
  case "$key" in
    categories) [[ "$value" =~ ^[0-7]$ ]] || die "wallhaven.categories must be a value from 0 to 7" ;;
    purity) [[ "$value" =~ ^(100|010|001)$ ]] || die "wallhaven.purity must be 100, 010, or 001" ;;
    sorting) case "$value" in relevance|random|date_added|views|favorites|toplist) ;; *) die "unknown wallhaven.sorting value: $value" ;; esac ;;
    ratios) [[ -z "$value" || "$value" =~ ^[0-9]+x[0-9]+(,[0-9]+x[0-9]+)*$ ]] || die "invalid wallhaven.ratios value: $value" ;;
    atleast) [[ "$value" =~ ^([0-9]+x[0-9]+)?$ ]] || die "invalid wallhaven.atleast value: $value" ;;
    *) die "unknown wallhaven config key: $key" ;;
  esac
  tmp=$(jq --arg k "$key" --arg v "$value" '.wallhaven[$k] = $v' "$CONFIG_FILE") || die "failed to update wallhaven.$key"
  printf '%s\n' "$tmp" > "$CONFIG_FILE"
}

# ---------------------------------------------------------------- wallhaven API

wallhaven_request() {
  local query="${1:-}" page="${2:-1}" categories="${3:-111}" purity="${4:-100}" sorting="${5:-relevance}" ratios="${6-}" atleast="${7-}" api_key="${WALLHAVEN_API_KEY:-}"
  local -a curl_args=(--silent --show-error --fail-with-body --get "https://wallhaven.cc/api/v1/search"
    --data-urlencode "page=$page"
    --data-urlencode "categories=$categories"
    --data-urlencode "purity=$purity"
    --data-urlencode "sorting=$sorting")
  [[ -n "$ratios" ]] && curl_args+=(--data-urlencode "ratios=$ratios")
  [[ -n "$query" ]] && curl_args+=(--data-urlencode "q=$query")
  [[ -n "$atleast" ]] && curl_args+=(--data-urlencode "atleast=$atleast")
  [[ -n "$api_key" ]] && curl_args+=(--data-urlencode "apikey=$api_key")
  curl "${curl_args[@]}"
}

wallhaven_search() {
  local query="${1:-}" page="${2:-1}" categories="${3:-$(wallhaven_config_get categories)}" purity="${4:-$(wallhaven_config_get purity)}" sorting="${5:-$(wallhaven_config_get sorting)}" ratios="${6-$(wallhaven_config_get ratios)}" atleast="${7-$(wallhaven_config_get atleast)}"
  wallhaven_request "$query" "$page" "$categories" "$purity" "$sorting" "$ratios" "$atleast" | jq -e 'if type == "object" and (.data | type == "array") then . else error("invalid Wallhaven response") end'
}

wallhaven_photos() {
  local page="${1:-1}" categories="${2:-$(wallhaven_config_get categories)}" purity="${3:-$(wallhaven_config_get purity)}" sorting="${4:-$(wallhaven_config_get sorting)}" ratios="${5-$(wallhaven_config_get ratios)}" atleast="${6-$(wallhaven_config_get atleast)}"
  wallhaven_request "" "$page" "$categories" "$purity" "$sorting" "$ratios" "$atleast" | jq -e 'if type == "object" and (.data | type == "array") then . else error("invalid Wallhaven response") end'
}

wallhaven_fetch() {
  local id="${1:?usage: wallhaven fetch <id> [dest_dir]}"
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid wallpaper id: $id"
  local dest="${2:-}"
  [[ -n "$dest" ]] || dest="${WALLPICKER_DOWNLOAD_DIR:-}"
  [[ -n "$dest" ]] || dest="$(cfg picturesDir)"
  [[ -n "$dest" ]] || dest="$HOME/Pictures"
  dest="${dest/#\~/$HOME}"
  local info response url ext mime tmp_path views favorites color
  response=$(curl --silent --show-error --fail-with-body --get "https://wallhaven.cc/api/v1/w/$id" | jq -c '.data // empty') || die "wallpaper id $id not found"
  [[ -n "$response" ]] || die "wallpaper id $id not found"
  info=$response
  url=$(jq -r '.path // empty' <<< "$info")
  ext=$(jq -r '.ext // "jpg"' <<< "$info")
  [[ "$ext" =~ ^(jpg|jpeg|png|webp)$ ]] || ext=jpg
  [[ -n "$url" ]] || die "wallpaper id $id has no download URL"
  tmp_path="$dest/wallhaven-$id.$ext"
  mkdir -p "$(dirname "$tmp_path")"
  if ! curl --silent --show-error --fail-with-body --location --output "$tmp_path" "$url"; then
    rm -f "$tmp_path"
    die "failed to download wallpaper $id"
  fi
  mime=$(file --mime-type -b "$tmp_path")
  case "$mime" in
    image/png|image/jpeg|image/webp) ;;
    *) rm -f "$tmp_path"; die "downloaded file is not a supported image: $url" ;;
  esac
  views=$(jq -r '.views // 0' <<< "$info")
  favorites=$(jq -r '.favorites // 0' <<< "$info")
  color=$(jq -r '.color // ""' <<< "$info")
  jq -n --arg id "$id" --arg url "$url" --arg color "$color" --arg ext "$ext" --argjson views "$views" --argjson favorites "$favorites" \
    '{id: $id, url: $url, color: $color, ext: $ext, views: $views, favorites: $favorites}' > "$tmp_path.source.json"
  echo "Downloaded: $tmp_path"
}

wallhaven_download() {
  local id="${1:?usage: wallhaven download <id>}"
  wallhaven_fetch "$id"
}

wallhaven_apply() {
  local id="${1:?usage: wallhaven apply <id>}"
  local out path
  out=$(wallhaven_fetch "$id") || exit $?
  path=${out#Downloaded: }
  [[ -n "$path" ]] || die "failed to apply wallpaper $id"
  omarchy theme bg set "$path" >/dev/null 2>&1 || omarchy-theme-bg-set "$path" >/dev/null 2>&1 || {
    rm -f "$path" "$path.source.json"
    die "failed to apply wallpaper"
  }
  echo "Downloaded and set: $path"
}

wallhaven_random() {
  local categories ratios purity atleast data url ext tmp_path mime views favorites
  categories=$(wallhaven_config_get categories)
  purity=$(wallhaven_config_get purity)
  ratios=$(wallhaven_config_get ratios)
  [[ -n "$ratios" ]] || ratios="16x9,16x10"
  atleast=$(wallhaven_config_get atleast)
  [[ -n "$atleast" ]] || atleast="1920x1080"
  data=$(wallhaven_request "" 1 "$categories" "$purity" "random" "$ratios" "$atleast" | jq -c '.data[0] // empty') || die "no wallpapers matching criteria"
  [[ -n "$data" ]] || die "no wallpapers matching criteria"
  url=$(jq -r '.path // empty' <<< "$data")
  ext=$(jq -r '.ext // "jpg"' <<< "$data")
  [[ "$ext" =~ ^(jpg|jpeg|png|webp)$ ]] || ext=jpg
  tmp_path="$HOME/.local/share/omarchy/themes/current/backgrounds/wallhaven-random.$ext"
  mkdir -p "$(dirname "$tmp_path")"
  if ! curl --silent --show-error --fail-with-body --location --output "$tmp_path" "$url"; then
    rm -f "$tmp_path"
    die "failed to download random wallpaper"
  fi
  mime=$(file --mime-type -b "$tmp_path")
  case "$mime" in
    image/png|image/jpeg|image/webp) ;;
    *) rm -f "$tmp_path"; die "downloaded file is not a supported image" ;;
  esac
  views=$(jq -r '.views // 0' <<< "$data")
  favorites=$(jq -r '.favorites // 0' <<< "$data")
  jq -n --arg id "random" --arg url "$url" --arg ext "$ext" --argjson views "$views" --argjson favorites "$favorites" \
    '{id: $id, url: $url, ext: $ext, views: $views, favorites: $favorites}' > "$tmp_path.source.json"
  omarchy theme bg set "$tmp_path" >/dev/null 2>&1 || omarchy-theme-bg-set "$tmp_path" >/dev/null 2>&1 || {
    rm -f "$tmp_path" "$tmp_path.source.json"
    die "failed to apply wallpaper"
  }
  echo "Random wallpaper set: $tmp_path"
}

wallhaven_prune() {
  local keep_last="${1:-20}"
  local theme_dir="$HOME/.local/share/omarchy/themes/current/backgrounds"
  local pictures_dir="${WALLPICKER_DOWNLOAD_DIR:-}"
  [[ -n "$pictures_dir" ]] || pictures_dir="$(cfg picturesDir)"
  [[ -n "$pictures_dir" ]] || pictures_dir="$HOME/Pictures"
  pictures_dir="${pictures_dir/#\~/$HOME}"
  local count
  count=$(ls -1 "$theme_dir"/wallhaven-* 2>/dev/null | wc -l)
  [[ "$count" -gt "$keep_last" ]] || return 0
  ls -1t "$theme_dir"/wallhaven-* 2>/dev/null | tail -n +$((keep_last + 1)) | xargs -r rm -f
  echo "Pruned to $keep_last wallhaven files (was $count)"
}

# ---------------------------------------------------------------- tags

wallhaven_tags() {
  local tags='landscape nature anime minimal dark cyberpunk 4k space'
  echo "$tags"
}

wallhaven_save() {
  local id="${1:?usage: wallpicker wallhaven save <id>}"
  wallhaven_fetch "$id"
}

wallhaven_current() {
  local theme_dir="$HOME/.local/share/omarchy/themes/current/backgrounds"
  local current
  if [[ -f "$STATE_FILE" ]]; then
    current=$(jq -r '.lastAppliedPath // ""' "$STATE_FILE" 2>/dev/null)
  fi
  if [[ -z "$current" || ! -f "$current" ]]; then
    current=$(ls -1t "$theme_dir"/wallhaven-* 2>/dev/null | head -1)
  fi
  if [[ -n "$current" && -f "$current" ]]; then
    local name ext
    name=$(basename "$current")
    ext="${name##*.}"
    local meta
    meta=$(cat "${current}.source.json" 2>/dev/null || echo '{}')
    echo "Current wallpaper: $name"
    echo "Path: $current"
    echo "Size: $(stat -c%s "$current" 2>/dev/null || echo unknown) bytes"
    echo "Metadata: $meta"
  else
    echo "No wallhaven wallpaper currently set"
  fi
}

# ---------------------------------------------------------------- dispatch

case "${1:-help}" in
  config)
    shift
    case "${1:-show}" in
      show) ensure_config; cat "$CONFIG_FILE" ;;
      path) echo "$CONFIG_FILE" ;;
      get)  cfg "${2:?usage: wallpicker config get <key>}" ;;
      set)  cfg_set "${2:?usage: wallpicker config set <key> <value>}" "${3-}" ;;
      *)    die "unknown config subcommand: $1" ;;
    esac
    ;;
  list)  cmd_list ;;
  thumbs) cmd_thumbs ;;
  collections)
    shift
    case "${1:-list}" in
      list)   cmd_collections_list ;;
      create) shift; cmd_collections_create "$@" ;;
      add)    shift; cmd_collections_add "$@" ;;
      remove) shift; cmd_collections_remove "$@" ;;
      delete) shift; cmd_collections_delete "$@" ;;
      prune)  shift; cmd_collections_prune "$@" ;;
      *)      die "unknown collections subcommand: $1 (use: list|create|add|remove|delete|prune)" ;;
    esac
    ;;
  themes) cmd_themes_list ;;
  remove) shift; cmd_remove "$@" ;;
  next)  cmd_next ;;
  apply) shift; cmd_apply "${1:?usage: wallpicker apply <path>}" ;;
  keybinds)
    shift
    case "${1:-show}" in
      apply)  apply_keybinds ;;
      clear)  clear_keybinds ;;
      show)
        ensure_config
        jq '{keybindOpen, keybindToggleRotation, keybindRotateNow}' "$CONFIG_FILE"
        ;;
      *) die "unknown keybinds subcommand: $1 (use: apply|clear|show)" ;;
    esac
    ;;
  desktop)
    shift
    case "${1:-install}" in
      install) desktop_install "${2:-.}" ;;
      remove)  desktop_remove ;;
      *)       die "unknown desktop subcommand: $1 (use: install|remove)" ;;
    esac
    ;;
  wallhaven)    shift
    case "${1:-}" in
      config)   shift; case "${1:-}" in get) wallhaven_config_get "${2:-}" ;; set) wallhaven_config_set "${2:-}" "${3:-}" ;; *) die "usage: wallhaven config get|set <key> [value]" ;; esac ;;
      tags)     wallhaven_tags ;;
      search)   shift; wallhaven_search "${1:-}" "${2:-1}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}" ;;
      photos)   shift; wallhaven_photos "${1:-1}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
      random)   wallhaven_random ;;
      fetch)    shift; wallhaven_fetch "${1:-}" "${2:-}" ;;
      download) shift; wallhaven_download "${1:-}" ;;
      save)     shift; wallhaven_save "${1:-}" ;;
      apply)    shift; wallhaven_apply "${1:-}" ;;
      prune)    shift; wallhaven_prune "${1:-20}" ;;
      current)  wallhaven_current ;;
      *)        die "unknown wallhaven subcommand: $1 (try: wallpicker help)" ;;
    esac
    ;;
help|-h|--help)
    cat <<'USAGE'
wallpicker — Wallpaper picker and rotation for Omarchy

  wallpicker list                    JSON array of {path, thumb} in picturesDir
  wallpicker thumbs                  Generate any missing cached thumbnails (parallel)
  wallpicker themes                  JSON array of Omarchy theme background images
  wallpicker collections list        JSON array of collections with their wallpapers
  wallpicker collections create <n> Create an empty collection named <n>
  wallpicker collections add <n> <p>...
                                     Add wallpapers to collection <n>
  wallpicker collections remove <n> <p>...
                                     Remove wallpapers from collection <n>
  wallpicker collections delete <n> Delete collection <n> (files are kept)
  wallpicker collections prune <p>...
                                     Drop wallpapers from every collection
  wallpicker remove <path>...        Move wallpapers to the system Trash
  wallpicker next                    Cycle to next wallpaper (random or sequential)
  wallpicker apply <path>            Set a specific wallpaper
  wallpicker config show|get|set     Read or edit ~/.config/omarchy/wallpicker.json
  wallpicker keybinds apply|clear    Generate/clear Hyprland keybind lua
  wallpicker desktop install|remove  Install/remove .desktop launcher entry
  wallhaven search <query> [page]    Search Wallhaven API, output JSON
  wallhaven photos [page]            Browse Wallhaven (no query)
  wallhaven random                   Download and set a random wallpaper
  wallhaven fetch <id> [dest_dir]    Download a wallpaper (no apply; default picturesDir)
  wallhaven download <id>            Download a wallpaper (no apply)
  wallhaven apply <id>               Download + set as wallpaper
  wallhaven save <id>                Download a wallpaper (no apply)
  wallhaven prune                    Keep only last N wallhaven files
  wallhaven current                  Show current wallhaven wallpaper info
  wallhaven tags                     List curated tag shortcuts
  wallhaven config get|set           Read or edit wallhaven config
USAGE
    ;;
  *) die "unknown command: $1 (try: wallpicker help)" ;;
esac